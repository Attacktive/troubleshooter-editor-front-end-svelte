{
	"name": "troubleshooter-editor",
	"version": "2.0.3",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000 --host",
		"serve": "vite dev --port 3000 --host --mode production",
		"build": "vite build",
		"build:production": "vite build --mode production",
		"preview": "vite preview --port 3000 --host",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "eslint ."
	},
	"dependencies": {
		"axios": "^1.21.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.19.2",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.0",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"jsdom": "^31.0.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"tslib": "^2.9.1",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	}
}
